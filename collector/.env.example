# Copy this file to .env and fill in the passwords. Never upload .env to GitHub.

# --- MQTT broker on site (through the WireGuard VPN) ---
MQTT_HOST=192.168.1.17
MQTT_PORT=1883
MQTT_USER=jeedom
MQTT_PASSWORD=put-the-mqtt-password-here
# Your own id. Never "jeedom" or "ug56".
MQTT_CLIENT_ID=hyperv-dev-kartheeban

# For a local test with fake_site.py, use instead:
# MQTT_HOST=127.0.0.1
# MQTT_USER=

# --- BEACON database (Docker on this PC) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beacon
DB_USER=beacon
DB_PASSWORD=put-the-database-password-here

SITE_CODE=VLT
BROKER_CODE=VLT-JEEDOM
